<Application x:Class="OllamaChat.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="Views/MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Load colors first so brushes are available to styles -->
                <ResourceDictionary Source="pack://application:,,,/OllamaChat;component/Resources/Colors.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/OllamaChat;component/Resources/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>

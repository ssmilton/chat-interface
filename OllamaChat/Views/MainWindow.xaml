<Window x:Class="OllamaChat.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:OllamaChat.ViewModels"
        xmlns:converters="clr-namespace:OllamaChat.Converters"
        mc:Ignorable="d"
        x:Name="MainWindowRef"
        Title="Ollama Chat"
        Height="800" Width="1400"
        MinHeight="600" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        Style="{StaticResource MainWindowStyle}">

    <Window.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibility"/>
        <converters:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibility"/>
        <converters:BoolToColorConverter x:Key="BoolToColor"/>
        <converters:InverseBoolConverter x:Key="InverseBool"/>

        <!-- Message Border Styles -->
        <Style x:Key="UserMessageStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource UserMessageBrush}"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Margin" Value="80,4,16,4"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
        </Style>

        <Style x:Key="AssistantMessageStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource AssistantMessageBrush}"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Margin" Value="16,4,80,4"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <!-- Sidebar -->
            <ColumnDefinition Width="280" x:Name="SidebarColumn"/>
            <!-- Main Content -->
            <ColumnDefinition Width="*"/>
            <!-- Artifacts Panel -->
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Grid.Column="0"
                Background="{StaticResource SidebarBackgroundBrush}"
                Visibility="{Binding IsSidebarVisible, Converter={StaticResource BoolToVisibility}}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- New Chat Button -->
                <Button Grid.Row="0"
                        Style="{StaticResource SidebarButton}"
                        Command="{Binding CreateNewChatCommand}"
                        Margin="8,12">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="+" FontSize="18" FontWeight="Bold" Margin="0,0,8,0"/>
                        <TextBlock Text="New Chat" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <!-- Search Box -->
                <Grid Grid.Row="1" Margin="8,4">
                    <TextBox Style="{StaticResource SearchTextBox}"
                             Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Return" Command="{Binding SearchChatsCommand}"/>
                        </TextBox.InputBindings>
                    </TextBox>
                    <TextBlock Text="Search chats..."
                               Foreground="{StaticResource PlaceholderTextBrush}"
                               IsHitTestVisible="False"
                               Margin="12,8"
                               Visibility="{Binding SearchQuery, Converter={StaticResource InverseBoolToVisibility}}"/>
                </Grid>

                <!-- Projects Section -->
                <Expander Grid.Row="2"
                          Header="Projects"
                          IsExpanded="True"
                          Style="{StaticResource ProjectExpander}"
                          Margin="4,8,4,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- New Project Input -->
                        <Grid Grid.Row="0" Margin="4,4,4,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="NewProjectNameTextBox"
                                     Style="{StaticResource SearchTextBox}"
                                     Text="{Binding NewProjectName, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="Enter project name">
                                <TextBox.InputBindings>
                                    <KeyBinding Key="Return" Command="{Binding CreateProjectFromInputCommand}"/>
                                </TextBox.InputBindings>
                            </TextBox>
                            <TextBlock Text="New project..."
                                       Foreground="{StaticResource PlaceholderTextBrush}"
                                       IsHitTestVisible="False"
                                       Margin="12,8"
                                       Visibility="{Binding NewProjectName, Converter={StaticResource InverseBoolToVisibility}}"/>
                            <Button Grid.Column="1"
                                    Style="{StaticResource IconButton}"
                                    Command="{Binding CreateProjectFromInputCommand}"
                                    ToolTip="Create Project"
                                    Margin="4,0,0,0">
                                <TextBlock Text="+" FontSize="16" FontWeight="Bold"/>
                            </Button>
                        </Grid>

                        <!-- Projects List -->
                        <ListBox Grid.Row="1"
                                 Style="{StaticResource ChatListBox}"
                                 ItemsSource="{Binding Projects}"
                                 SelectedItem="{Binding SelectedProject}"
                                 SelectionChanged="ProjectsListBox_SelectionChanged"
                                 MaxHeight="150">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ContextMenu>
                                            <ContextMenu>
                                                <MenuItem Header="Delete Project"
                                                          Command="{Binding DataContext.DeleteProjectCommand, Source={x:Reference Name=MainWindowRef}}"
                                                          CommandParameter="{Binding}"/>
                                            </ContextMenu>
                                        </Grid.ContextMenu>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="📁" Margin="0,0,8,0"/>
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding Name}"
                                                   Foreground="{StaticResource PrimaryTextBrush}"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Grid.Column="2"
                                                   Text="{Binding Chats.Count, StringFormat='({0})'}"
                                                   Foreground="{StaticResource SecondaryTextBrush}"
                                                   FontSize="11"
                                                   Margin="8,0,0,0"/>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <!-- Clear Project Filter Button -->
                        <Button Grid.Row="2"
                                Style="{StaticResource SidebarButton}"
                                Content="Show All Chats"
                                Command="{Binding ClearProjectFilterCommand}"
                                Visibility="{Binding SelectedProject, Converter={StaticResource BoolToVisibility}}"
                                Margin="4,4,4,0"
                                FontSize="11"/>
                    </Grid>
                </Expander>

                <!-- Recent Chats -->
                <Grid Grid.Row="3">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="12,12,12,4">
                        <TextBlock Text="Recent Chats"
                                   Foreground="{StaticResource SecondaryTextBrush}"
                                   FontSize="12"
                                   Visibility="{Binding SelectedProject, Converter={StaticResource InverseBoolToVisibility}}"/>
                        <TextBlock Foreground="{StaticResource SecondaryTextBrush}"
                                   FontSize="12"
                                   Visibility="{Binding SelectedProject, Converter={StaticResource BoolToVisibility}}">
                            <Run Text="Chats in: "/>
                            <Run Text="{Binding SelectedProject.Name}" FontWeight="SemiBold"/>
                        </TextBlock>
                    </StackPanel>

                    <ListBox Grid.Row="1"
                             Style="{StaticResource ChatListBox}"
                             ItemsSource="{Binding RecentChats}"
                             SelectedItem="{Binding SelectedChatItem}"
                             SelectionChanged="RecentChatsListBox_SelectionChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="Rename"
                                                      Command="{Binding DataContext.StartRenameChatCommand, Source={x:Reference Name=MainWindowRef}}"
                                                      CommandParameter="{Binding}"/>
                                            <MenuItem Header="Assign to Project"
                                                      Command="{Binding DataContext.ShowAssignToProjectDialogCommand, Source={x:Reference Name=MainWindowRef}}"
                                                      CommandParameter="{Binding}"/>
                                            <MenuItem Header="Remove from Project"
                                                      Command="{Binding DataContext.RemoveChatFromProjectCommand, Source={x:Reference Name=MainWindowRef}}"
                                                      CommandParameter="{Binding}"/>
                                            <Separator/>
                                            <MenuItem Header="Delete"
                                                      Command="{Binding DataContext.DeleteChatCommand, Source={x:Reference Name=MainWindowRef}}"
                                                      CommandParameter="{Binding}"/>
                                        </ContextMenu>
                                    </Grid.ContextMenu>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <!-- Title display (when not editing) -->
                                    <TextBlock Grid.Column="0" Grid.Row="0"
                                               Text="{Binding Title}"
                                               Foreground="{StaticResource PrimaryTextBrush}"
                                               FontWeight="Medium"
                                               TextTrimming="CharacterEllipsis"
                                               Visibility="{Binding IsEditing, Converter={StaticResource InverseBoolToVisibility}}"/>

                                    <!-- Title edit TextBox (when editing) -->
                                    <TextBox Grid.Column="0" Grid.Row="0"
                                             Text="{Binding EditingTitle, UpdateSourceTrigger=PropertyChanged}"
                                             Foreground="{StaticResource PrimaryTextBrush}"
                                             Background="{StaticResource HoverBackgroundBrush}"
                                             BorderThickness="1"
                                             BorderBrush="{StaticResource AccentBrush}"
                                             Padding="2"
                                             Visibility="{Binding IsEditing, Converter={StaticResource BoolToVisibility}}">
                                        <TextBox.InputBindings>
                                            <KeyBinding Key="Return"
                                                        Command="{Binding DataContext.ConfirmRenameChatCommand, Source={x:Reference Name=MainWindowRef}}"
                                                        CommandParameter="{Binding}"/>
                                            <KeyBinding Key="Escape"
                                                        Command="{Binding DataContext.CancelRenameChatCommand, Source={x:Reference Name=MainWindowRef}}"
                                                        CommandParameter="{Binding}"/>
                                        </TextBox.InputBindings>
                                    </TextBox>

                                    <TextBlock Grid.Column="1" Grid.Row="0"
                                               Text="{Binding FormattedDate}"
                                               Foreground="{StaticResource SecondaryTextBrush}"
                                               FontSize="11"
                                               Margin="8,0,0,0"/>

                                    <!-- Project Badge -->
                                    <Border Grid.Column="0" Grid.Row="1"
                                            Background="{StaticResource AccentBrush}"
                                            CornerRadius="3"
                                            Padding="4,1"
                                            HorizontalAlignment="Left"
                                            Visibility="{Binding ProjectName, Converter={StaticResource BoolToVisibility}}"
                                            Margin="0,4,0,0">
                                        <TextBlock Text="{Binding ProjectName}"
                                                   Foreground="White"
                                                   FontSize="10"/>
                                    </Border>

                                    <TextBlock Grid.Column="0" Grid.Row="2" Grid.ColumnSpan="2"
                                               Text="{Binding LastMessage}"
                                               Foreground="{StaticResource SecondaryTextBrush}"
                                               FontSize="12"
                                               TextTrimming="CharacterEllipsis"
                                               Margin="0,4,0,0"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>

                <!-- Connection Status & Settings -->
                <Border Grid.Row="4"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="0,1,0,0"
                        Padding="12,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse Width="8" Height="8"
                                     Fill="{Binding IsServerConnected, Converter={StaticResource BoolToColor}}"
                                     Margin="0,0,8,0"/>
                            <TextBlock Text="{Binding ConnectionStatus}"
                                       Foreground="{StaticResource SecondaryTextBrush}"
                                       FontSize="12"/>
                        </StackPanel>

                        <Button Grid.Column="1"
                                Style="{StaticResource IconButton}"
                                Command="{Binding CheckServerConnectionCommand}"
                                ToolTip="Refresh connection">
                            <TextBlock Text="↻" FontSize="16"/>
                        </Button>
                        <Button Grid.Column="2"
                                Style="{StaticResource IconButton}"
                                Command="{Binding OpenSettingsCommand}"
                                ToolTip="Settings"
                                Margin="4,0,0,0">
                            <TextBlock Text="⚙" FontSize="16"/>
                        </Button>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- Main Chat Area -->
        <Grid Grid.Column="1" Background="{StaticResource ChatBackgroundBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border Grid.Row="0"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,0,0,1"
                    Padding="16,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                        <Button Style="{StaticResource IconButton}"
                                Command="{Binding ToggleSidebarCommand}"
                                ToolTip="Toggle sidebar">
                            <TextBlock Text="☰" FontSize="18"/>
                        </Button>

                        <!-- Current Chat Title -->
                        <TextBlock Text="{Binding CurrentChat.Title}"
                                   Foreground="{StaticResource PrimaryTextBrush}"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"
                                   MaxWidth="200"
                                   Margin="12,0,0,0"
                                   Visibility="{Binding CurrentChat, Converter={StaticResource BoolToVisibility}}"/>

                        <!-- Current Project Badge -->
                        <Border Background="{StaticResource AccentBrush}"
                                CornerRadius="3"
                                Padding="6,2"
                                VerticalAlignment="Center"
                                Margin="8,0,0,0"
                                Visibility="{Binding CurrentChatHasProject, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="{Binding CurrentChat.Project.Name}"
                                       Foreground="White"
                                       FontSize="11"/>
                        </Border>
                    </StackPanel>

                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                HorizontalAlignment="Center">
                        <TextBlock Text="Model: "
                                   Foreground="{StaticResource SecondaryTextBrush}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,8,0"/>
                        <ComboBox Style="{StaticResource ModelComboBox}"
                                  ItemsSource="{Binding AvailableModels}"
                                  SelectedValue="{Binding SelectedModel}"
                                  DisplayMemberPath="Name"
                                  SelectedValuePath="Name"
                                  Width="200"/>

                        <!-- Project Context Sharing Toggle -->
                        <Border Margin="16,0,0,0"
                                Visibility="{Binding CurrentChatHasProject, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel Orientation="Horizontal">
                                <CheckBox IsChecked="{Binding UseProjectContext}"
                                          VerticalAlignment="Center"/>
                                <TextBlock Text="Share Project Context"
                                           Foreground="{StaticResource SecondaryTextBrush}"
                                           VerticalAlignment="Center"
                                           Margin="4,0,0,0"
                                           ToolTip="Include conversation history from other chats in this project"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <Button Grid.Column="2"
                            Style="{StaticResource IconButton}"
                            Command="{Binding ToggleArtifactsPanelCommand}"
                            ToolTip="Toggle artifacts panel"
                            Visibility="{Binding Artifacts.Count, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="📄" FontSize="16"/>
                    </Button>
                </Grid>
            </Border>

            <!-- Messages Area -->
            <ScrollViewer Grid.Row="1"
                          VerticalScrollBarVisibility="Auto"
                          x:Name="MessagesScrollViewer">
                <ItemsControl ItemsSource="{Binding Messages}" Margin="0,16">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="16,4"
                                    CornerRadius="12"
                                    Padding="16">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="{StaticResource AssistantMessageBrush}"/>
                                        <Setter Property="HorizontalAlignment" Value="Left"/>
                                        <Setter Property="Margin" Value="16,4,80,4"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsUser}" Value="True">
                                                <Setter Property="Background" Value="{StaticResource UserMessageBrush}"/>
                                                <Setter Property="HorizontalAlignment" Value="Right"/>
                                                <Setter Property="Margin" Value="80,4,16,4"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <!-- Role Label -->
                                    <TextBlock Grid.Row="0"
                                               Text="{Binding Role}"
                                               Foreground="{StaticResource SecondaryTextBrush}"
                                               FontSize="12"
                                               FontWeight="SemiBold"                                        
                                               Margin="0,0,0,8"/>

                                    <!-- Message Content -->
                                    <TextBlock Grid.Row="1"
                                               Text="{Binding Content}"
                                               Foreground="{StaticResource PrimaryTextBrush}"
                                               TextWrapping="Wrap"
                                               LineHeight="24"/>

                                    <!-- Attachments -->
                                    <ItemsControl Grid.Row="2"
                                                  ItemsSource="{Binding Attachments}"
                                                  Visibility="{Binding Attachments.Count, Converter={StaticResource BoolToVisibility}}"
                                                  Margin="0,8,0,0">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="{StaticResource HoverBackgroundBrush}"
                                                        CornerRadius="4"
                                                        Padding="8,4"
                                                        Margin="0,2">
                                                    <TextBlock Text="{Binding FileName}"
                                                               Foreground="{StaticResource LinkTextBrush}"
                                                               FontSize="12"/>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <!-- Streaming Indicator -->
                                    <TextBlock Grid.Row="2"
                                               Text="●●●"
                                               Foreground="{StaticResource AccentBrush}"
                                               Visibility="{Binding IsStreaming, Converter={StaticResource BoolToVisibility}}"
                                               Margin="0,8,0,0"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- Input Area -->
            <Border Grid.Row="2"
                    Background="{StaticResource SecondaryBackgroundBrush}"
                    Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Pending Attachments -->
                    <ItemsControl Grid.Row="0"
                                  ItemsSource="{Binding PendingAttachments}"
                                  Visibility="{Binding PendingAttachments.Count, Converter={StaticResource BoolToVisibility}}"
                                  Margin="0,0,0,8">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource HoverBackgroundBrush}"
                                        CornerRadius="4"
                                        Padding="8,4"
                                        Margin="0,0,4,4">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding}"
                                                   Foreground="{StaticResource PrimaryTextBrush}"
                                                   FontSize="12"
                                                   MaxWidth="150"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <Button Style="{StaticResource IconButton}"
                                                Content="×"
                                                FontSize="14"
                                                Padding="4,0"
                                                Command="{Binding DataContext.RemoveAttachmentCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Input Box -->
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0"
                                Style="{StaticResource IconButton}"
                                Command="{Binding AttachFileCommand}"
                                ToolTip="Attach file"
                                VerticalAlignment="Bottom"
                                Margin="0,0,8,0">
                            <TextBlock Text="📎" FontSize="18"/>
                        </Button>

                        <TextBox Grid.Column="1"
                                 Style="{StaticResource ChatInputTextBox}"
                                 Text="{Binding MessageInput, UpdateSourceTrigger=PropertyChanged}"
                                 MaxHeight="200"
                                 VerticalAlignment="Bottom"
                                 x:Name="MessageInputBox">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Return" Command="{Binding SendMessageCommand}"/>
                            </TextBox.InputBindings>
                        </TextBox>

                        <Button Grid.Column="2"
                                Style="{StaticResource PrimaryButton}"
                                Command="{Binding SendMessageCommand}"
                                IsEnabled="{Binding IsSending, Converter={StaticResource InverseBool}}"
                                VerticalAlignment="Bottom"
                                Margin="8,0,0,0"
                                Visibility="{Binding IsSending, Converter={StaticResource InverseBoolToVisibility}}">
                            <TextBlock Text="Send" FontWeight="SemiBold"/>
                        </Button>

                        <Button Grid.Column="2"
                                Style="{StaticResource IconButton}"
                                Command="{Binding StopGeneratingCommand}"
                                VerticalAlignment="Bottom"
                                Margin="8,0,0,0"
                                Visibility="{Binding IsSending, Converter={StaticResource BoolToVisibility}}"
                                ToolTip="Stop generating">
                            <Border Background="{StaticResource ErrorBrush}"
                                    CornerRadius="4"
                                    Width="24" Height="24"/>
                        </Button>
                    </Grid>
                </Grid>
            </Border>

            <!-- Error Message -->
            <Border Grid.Row="1"
                    Background="{StaticResource ErrorBrush}"
                    Visibility="{Binding ErrorMessage, Converter={StaticResource BoolToVisibility}}"
                    CornerRadius="8"
                    Padding="12"
                    Margin="16"
                    VerticalAlignment="Top"
                    HorizontalAlignment="Center">
                <TextBlock Text="{Binding ErrorMessage}"
                           Foreground="White"/>
            </Border>
        </Grid>

        <!-- Artifacts Panel -->
        <Border Grid.Column="2"
                Width="350"
                Background="{StaticResource SecondaryBackgroundBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1,0,0,0"
                Visibility="{Binding IsArtifactsPanelVisible, Converter={StaticResource BoolToVisibility}}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Artifacts Header -->
                <Border Grid.Row="0"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="0,0,0,1"
                        Padding="16,12">
                    <Grid>
                        <TextBlock Text="Artifacts"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource PrimaryTextBrush}"/>
                        <Button Style="{StaticResource IconButton}"
                                HorizontalAlignment="Right"
                                Command="{Binding ToggleArtifactsPanelCommand}">
                            <TextBlock Text="×" FontSize="18"/>
                        </Button>
                    </Grid>
                </Border>

                <!-- Artifacts List -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Artifacts}" Margin="8">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource HoverBackgroundBrush}"
                                        CornerRadius="8"
                                        Margin="4"
                                        Padding="12">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <!-- Title -->
                                        <Grid Grid.Row="0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Text="{Binding DisplayTitle}"
                                                       Foreground="{StaticResource PrimaryTextBrush}"
                                                       FontWeight="Medium"/>

                                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                <Button Style="{StaticResource IconButton}"
                                                        Command="{Binding DataContext.CopyArtifactCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}"
                                                        ToolTip="Copy">
                                                    <TextBlock Text="📋" FontSize="12"/>
                                                </Button>
                                                <Button Style="{StaticResource IconButton}"
                                                        Command="{Binding DataContext.SaveArtifactCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}"
                                                        ToolTip="Save">
                                                    <TextBlock Text="💾" FontSize="12"/>
                                                </Button>
                                            </StackPanel>
                                        </Grid>

                                        <!-- Preview -->
                                        <Border Grid.Row="1"
                                                Style="{StaticResource CodeBlock}"
                                                MaxHeight="200"
                                                Margin="0,8,0,0">
                                            <ScrollViewer VerticalScrollBarVisibility="Auto"
                                                          HorizontalScrollBarVisibility="Auto">
                                                <TextBlock Style="{StaticResource CodeText}"
                                                           Text="{Binding Content}"/>
                                            </ScrollViewer>
                                        </Border>

                                        <!-- Version Info -->
                                        <TextBlock Grid.Row="2"
                                                   Text="{Binding Version, StringFormat='v{0}'}"
                                                   Foreground="{StaticResource SecondaryTextBrush}"
                                                   FontSize="11"
                                                   Margin="0,4,0,0"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- Assign to Project Dialog Overlay -->
        <Border Grid.ColumnSpan="3"
                Background="#80000000"
                Visibility="{Binding IsAssignProjectDialogVisible, Converter={StaticResource BoolToVisibility}}">
            <Border Background="{StaticResource SecondaryBackgroundBrush}"
                    CornerRadius="8"
                    Padding="24"
                    Width="350"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <TextBlock Grid.Row="0"
                               Text="Assign to Project"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource PrimaryTextBrush}"
                               Margin="0,0,0,8"/>

                    <TextBlock Grid.Row="1"
                               Text="{Binding ChatToAssign.Title, StringFormat='Chat: {0}'}"
                               Foreground="{StaticResource SecondaryTextBrush}"
                               TextTrimming="CharacterEllipsis"
                               Margin="0,0,0,16"/>

                    <!-- Projects List -->
                    <ListBox Grid.Row="2"
                             Style="{StaticResource ChatListBox}"
                             ItemsSource="{Binding Projects}"
                             MaxHeight="250"
                             Margin="0,0,0,16">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource SidebarButton}"
                                        HorizontalContentAlignment="Left"
                                        Command="{Binding DataContext.AssignChatToProjectCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="📁" Margin="0,0,8,0"/>
                                        <TextBlock Text="{Binding Name}"/>
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- Cancel Button -->
                    <Button Grid.Row="3"
                            Content="Cancel"
                            Style="{StaticResource SidebarButton}"
                            Command="{Binding CancelAssignProjectCommand}"
                            HorizontalAlignment="Right"/>
                </Grid>
            </Border>
        </Border>
    </Grid>
</Window>

<Window x:Class="OllamaChat.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Settings"
        Height="500" Width="500"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#1E1E1E">

    <Window.Resources>
        <Style x:Key="SettingsLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#ECECF1"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>

        <Style x:Key="SettingsTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="#2D2D2D"/>
            <Setter Property="Foreground" Value="#ECECF1"/>
            <Setter Property="BorderBrush" Value="#3E3E42"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <Style x:Key="SettingsCheckBox" TargetType="CheckBox">
            <Setter Property="Foreground" Value="#ECECF1"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock Grid.Row="0"
                   Text="Ollama Settings"
                   FontSize="20"
                   FontWeight="SemiBold"
                   Foreground="#ECECF1"
                   Margin="0,0,0,20"/>

        <!-- Settings Form -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- Server Configuration -->
                <TextBlock Text="Server Configuration"
                           FontSize="16"
                           FontWeight="SemiBold"
                           Foreground="#10A37F"
                           Margin="0,0,0,12"/>

                <StackPanel Margin="0,0,0,16">
                    <TextBlock Style="{StaticResource SettingsLabel}" Text="Base URL"/>
                    <TextBox x:Name="BaseUrlTextBox"
                             Style="{StaticResource SettingsTextBox}"
                             Text="http://localhost:11434"/>
                    <TextBlock Text="The URL where your Ollama server is running"
                               Foreground="#8E8EA0"
                               FontSize="11"
                               Margin="0,4,0,0"/>
                </StackPanel>

                <StackPanel Margin="0,0,0,16">
                    <TextBlock Style="{StaticResource SettingsLabel}" Text="Default Model"/>
                    <TextBox x:Name="DefaultModelTextBox"
                             Style="{StaticResource SettingsTextBox}"
                             Text="llama3.2"/>
                    <TextBlock Text="The default model to use for new chats"
                               Foreground="#8E8EA0"
                               FontSize="11"
                               Margin="0,4,0,0"/>
                </StackPanel>

                <StackPanel Margin="0,0,0,16">
                    <TextBlock Style="{StaticResource SettingsLabel}" Text="Request Timeout (seconds)"/>
                    <TextBox x:Name="TimeoutTextBox"
                             Style="{StaticResource SettingsTextBox}"
                             Text="300"/>
                </StackPanel>

                <CheckBox x:Name="StreamResponsesCheckBox"
                          Style="{StaticResource SettingsCheckBox}"
                          Content="Stream responses"
                          IsChecked="True"
                          Margin="0,0,0,20"/>

                <!-- Model Options -->
                <TextBlock Text="Model Options"
                           FontSize="16"
                           FontWeight="SemiBold"
                           Foreground="#10A37F"
                           Margin="0,12,0,12"/>

                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Style="{StaticResource SettingsLabel}" Text="Temperature"/>
                        <TextBox x:Name="TemperatureTextBox"
                                 Style="{StaticResource SettingsTextBox}"
                                 Text="0.7"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Style="{StaticResource SettingsLabel}" Text="Top P"/>
                        <TextBox x:Name="TopPTextBox"
                                 Style="{StaticResource SettingsTextBox}"
                                 Text="0.9"/>
                    </StackPanel>
                </Grid>

                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Style="{StaticResource SettingsLabel}" Text="Top K"/>
                        <TextBox x:Name="TopKTextBox"
                                 Style="{StaticResource SettingsTextBox}"
                                 Text="40"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Style="{StaticResource SettingsLabel}" Text="Context Length"/>
                        <TextBox x:Name="ContextLengthTextBox"
                                 Style="{StaticResource SettingsTextBox}"
                                 Text="4096"/>
                    </StackPanel>
                </Grid>

                <StackPanel Margin="0,0,0,16">
                    <TextBlock Style="{StaticResource SettingsLabel}" Text="Repeat Penalty"/>
                    <TextBox x:Name="RepeatPenaltyTextBox"
                             Style="{StaticResource SettingsTextBox}"
                             Text="1.1"/>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <!-- Buttons -->
        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,20,0,0">
            <Button Content="Cancel"
                    Width="100"
                    Padding="12,8"
                    Background="Transparent"
                    Foreground="#ECECF1"
                    BorderBrush="#3E3E42"
                    Click="CancelButton_Click"/>
            <Button Content="Save"
                    Width="100"
                    Margin="12,0,0,0"
                    Padding="12,8"
                    Background="#10A37F"
                    Foreground="White"
                    BorderThickness="0"
                    Click="SaveButton_Click"/>
        </StackPanel>
    </Grid>
</Window>

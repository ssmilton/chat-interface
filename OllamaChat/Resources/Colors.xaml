<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Dark Theme Colors (Claude/ChatGPT inspired) -->

    <!-- Background Colors -->
    <Color x:Key="PrimaryBackgroundColor">#1E1E1E</Color>
    <Color x:Key="SecondaryBackgroundColor">#252526</Color>
    <Color x:Key="SidebarBackgroundColor">#171717</Color>
    <Color x:Key="ChatBackgroundColor">#212121</Color>
    <Color x:Key="InputBackgroundColor">#2D2D2D</Color>
    <Color x:Key="HoverBackgroundColor">#3C3C3C</Color>
    <Color x:Key="SelectedBackgroundColor">#4A4A4A</Color>

    <!-- Text Colors -->
    <Color x:Key="PrimaryTextColor">#ECECF1</Color>
    <Color x:Key="SecondaryTextColor">#CC5500</Color>
    <Color x:Key="PlaceholderTextColor">#6B6B7B</Color>
    <Color x:Key="LinkTextColor">#7AB8FF</Color>

    <!-- Accent Colors -->
    <Color x:Key="AccentColor">#10A37F</Color>
    <Color x:Key="AccentHoverColor">#0D8A6C</Color>
    <Color x:Key="UserMessageColor">#343541</Color>
    <Color x:Key="AssistantMessageColor">#444654</Color>

    <!-- Border Colors -->
    <Color x:Key="BorderColor">#3E3E42</Color>
    <Color x:Key="FocusBorderColor">#10A37F</Color>

    <!-- Status Colors -->
    <Color x:Key="SuccessColor">#10A37F</Color>
    <Color x:Key="WarningColor">#F5A623</Color>
    <Color x:Key="ErrorColor">#EF4444</Color>

    <!-- Thinking Content Colors -->
    <Color x:Key="ThinkingBackgroundColor">#2D2D3A</Color>
    <Color x:Key="ThinkingTextColor">#A0A0C0</Color>
    <Color x:Key="ThinkingBorderColor">#6B5B95</Color>

    <!-- Brushes -->
    <SolidColorBrush x:Key="PrimaryBackgroundBrush" Color="{StaticResource PrimaryBackgroundColor}"/>
    <SolidColorBrush x:Key="SecondaryBackgroundBrush" Color="{StaticResource SecondaryBackgroundColor}"/>
    <SolidColorBrush x:Key="SidebarBackgroundBrush" Color="{StaticResource SidebarBackgroundColor}"/>
    <SolidColorBrush x:Key="ChatBackgroundBrush" Color="{StaticResource ChatBackgroundColor}"/>
    <SolidColorBrush x:Key="InputBackgroundBrush" Color="{StaticResource InputBackgroundColor}"/>
    <SolidColorBrush x:Key="HoverBackgroundBrush" Color="{StaticResource HoverBackgroundColor}"/>
    <SolidColorBrush x:Key="SelectedBackgroundBrush" Color="{StaticResource SelectedBackgroundColor}"/>

    <SolidColorBrush x:Key="PrimaryTextBrush" Color="{StaticResource PrimaryTextColor}"/>
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="{StaticResource SecondaryTextColor}"/>
    <SolidColorBrush x:Key="PlaceholderTextBrush" Color="{StaticResource PlaceholderTextColor}"/>
    <SolidColorBrush x:Key="LinkTextBrush" Color="{StaticResource LinkTextColor}"/>

    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}"/>
    <SolidColorBrush x:Key="AccentHoverBrush" Color="{StaticResource AccentHoverColor}"/>
    <SolidColorBrush x:Key="UserMessageBrush" Color="{StaticResource UserMessageColor}"/>
    <SolidColorBrush x:Key="AssistantMessageBrush" Color="{StaticResource AssistantMessageColor}"/>

    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}"/>
    <SolidColorBrush x:Key="FocusBorderBrush" Color="{StaticResource FocusBorderColor}"/>

    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}"/>
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}"/>
    <SolidColorBrush x:Key="ErrorBrush" Color="{StaticResource ErrorColor}"/>

    <SolidColorBrush x:Key="ThinkingBackgroundBrush" Color="{StaticResource ThinkingBackgroundColor}"/>
    <SolidColorBrush x:Key="ThinkingTextBrush" Color="{StaticResource ThinkingTextColor}"/>
    <SolidColorBrush x:Key="ThinkingBorderBrush" Color="{StaticResource ThinkingBorderColor}"/>

</ResourceDictionary>
